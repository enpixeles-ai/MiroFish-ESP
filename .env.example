# =============================================
# MIROFISH-ESP — CONFIGURACIÓN DE VARIABLES
# Copia este archivo como .env y agrega tus keys
# cp .env.example .env
# =============================================

# LLM API — Compatible con cualquier API formato OpenAI
# Recomendado: Gemini 3 Flash (Google AI Studio - gratis)
# Obtén tu key en: https://aistudio.google.com/
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL_NAME=gemini-3-flash-preview

# Zep Cloud — Memoria de agentes
# Tier gratuito disponible en: https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# Seguridad / producción
SECRET_KEY=replace_with_a_long_random_secret
FLASK_DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Limites de seguridad para OASIS/CAMEL
MIROFISH_AGENT_MESSAGE_WINDOW_SIZE=8
MIROFISH_AGENT_MEMORY_RECORDS=24
MIROFISH_AGENT_TOKEN_LIMIT=64000
MIROFISH_AGENT_STEP_TIMEOUT_SECONDS=180
MIROFISH_OASIS_SEMAPHORE=8
MIROFISH_ROUND_STEP_ATTEMPTS=2
MIROFISH_MAX_CONSECUTIVE_ROUND_FAILURES=3

# URL del backend (cambia por tu IP si usas VPS)
VITE_API_BASE_URL=http://localhost:5001
